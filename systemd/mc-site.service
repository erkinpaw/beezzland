[Unit]
Description=BeezzLand website (status, map, duels, ban list, player accounts)
After=network-online.target mc-proxy.service

[Service]
User=minecraft
WorkingDirectory=/opt/mc/site
# BANS_DSN (LibertyBans in MariaDB), written by setup.sh
EnvironmentFile=-/opt/mc/.site.env
ExecStart=/usr/bin/python3 -I server.py --host 127.0.0.1 --port 8080 --mc 127.0.0.1:25565 --map 127.0.0.1:8100 --webtrade /opt/mc/survival/plugins/WebTrade --sessions /opt/mc/site-sessions.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
